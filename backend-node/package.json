{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate --schema prisma/schema.prisma",
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "prestart": "prisma generate --schema prisma/schema.prisma",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "seed": "tsx src/seed.ts",
    "reset-db": "tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "axios": "^1.16.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "form-data": "^4.0.5",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "^1.10.1",
    "multer": "2.1.1",
    "nodemailer": "8.0.7",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "pg-mem": "^3.0.14",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "7.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "3.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "2.1.0",
    "@types/node": "25.9.1",
    "@types/nodemailer": "8.0.0",
    "@types/passport-oauth2": "^1.8.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "10.4.0",
    "jest": "30.4.2",
    "nodemon": "3.1.14",
    "pino-pretty": "^13.1.3",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.10",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.8.17",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
