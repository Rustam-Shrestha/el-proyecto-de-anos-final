    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const body = pm.response.json();",
                  "  if (body && body.data && body.data.id) {",
                  "    pm.environment.set('documentId', body.data.id);",
                  "  }",
                  "} catch (error) {",
                  "  // Ignore non-JSON responses.",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "document",
                  "type": "file",
                  "src": "{{documentFilePath}}"
                },
                {
                  "key": "kycId",
                  "type": "text",
                  "value": "{{kycId}}"
                },
                {
                  "key": "type",
                  "type": "text",
                  "value": "{{documentType}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/{{apiVersion}}/documents/upload"
          }
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/{{apiVersion}}/documents/{{documentId}}"
          }
        },
        {
