              "mode": "formdata",
              "formdata": [
                {
                  "key": "document",
                  "type": "file",
                  "src": "{{replacementFilePath}}"
                },
                {
                  "key": "type",
                  "type": "text",
                  "value": "{{documentType}}"
                }
              ]
            },
            "url": "{{baseUrl}}/api/{{apiVersion}}/documents/{{documentId}}/replace"
          }
        }
      ]
