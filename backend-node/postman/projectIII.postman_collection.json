    {
      "name": "KYC",
      "item": [
        {
          "name": "Submit KYC",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const body = pm.response.json();",
                  "  if (body && body.data && body.data.id) {",
                  "    pm.environment.set('kycId', body.data.id);",
                  "  }",
                  "} catch (error) {",
                  "  // Ignore non-JSON responses.",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documents\": [\n    {\n      \"type\": \"CITIZENSHIP_FRONT\",\n      \"filePath\": \"uploads/kyc/citizenship-front.png\",\n      \"mimeType\": \"image/png\",\n      \"sizeBytes\": 102400\n    },\n    {\n      \"type\": \"SELFIE\",\n      \"filePath\": \"uploads/kyc/selfie.png\",\n      \"mimeType\": \"image/png\",\n      \"sizeBytes\": 92340\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
              },
            "url": "{{baseUrl}}/api/{{apiVersion}}/kyc/submit"
          }
        },
        {
          "name": "Get My KYC Status",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "try {",
                    "  const body = pm.response.json();",
                    "  if (body && body.data && body.data.id) {",
                    "    pm.environment.set('kycId', body.data.id);",
                    "  }",
                    "} catch (error) {",
                    "  // Ignore non-JSON responses.",
                    "}"
                  ]
                }
              }
            ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/{{apiVersion}}/kyc/status"
          }
        },
        {
          "name": "List KYC Applications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/{{apiVersion}}/kyc?page={{page}}&limit={{limit}}&status={{status}}&search={{search}}"
          }
        },
        {
          "name": "Get KYC By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/{{apiVersion}}/kyc/{{kycId}}"
          }
        },
        {
          "name": "Approve KYC",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/{{apiVersion}}/kyc/{{kycId}}/approve"
          }
        },
        {
          "name": "Reject KYC",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"{{rejectionReason}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/{{apiVersion}}/kyc/{{kycId}}/reject"
          }
        },
        {
          "name": "Request KYC Resubmit",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"{{resubmitNote}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/{{apiVersion}}/kyc/{{kycId}}/request-resubmit"
          }
        }
      ]
