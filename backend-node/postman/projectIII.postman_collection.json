{
  "info": {
    "_postman_id": "projectIII-postman-collection",
    "name": "ProjectIII Backend Node API",
    "description": "Import this collection together with the matching environment file. The collection stores access and refresh tokens automatically after auth responses and keeps the most frequently used IDs and variables in one place.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "try {",
          "  const body = pm.response.json();",
          "  const data = body && body.data ? body.data : null;",
          "  if (data && typeof data === 'object') {",
          "    if (data.accessToken) {",
          "      pm.environment.set('accessToken', data.accessToken);",
          "    }",
          "    if (data.refreshToken) {",
          "      pm.environment.set('refreshToken', data.refreshToken);",
          "    }",
          "    if (data.user && typeof data.user === 'object') {",
          "      if (data.user.id) {",
          "        pm.environment.set('currentUserId', data.user.id);",
          "      }",
          "      if (data.user.email) {",
          "        pm.environment.set('currentUserEmail', data.user.email);",
          "      }",
          "      if (data.user.role) {",
          "        pm.environment.set('currentUserRole', data.user.role);",
          "      }",
          "      if (typeof data.user.isVerified !== 'undefined') {",
          "        pm.environment.set('currentUserIsVerified', String(data.user.isVerified));",
          "      }",
          "    }",
          "  }",
          "} catch (error) {",
          "  // Ignore non-JSON or non-auth responses.",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/{{apiVersion}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/{{apiVersion}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
