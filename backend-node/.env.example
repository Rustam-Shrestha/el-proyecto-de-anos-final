# =========================================
# FinGuard Backend Environment Configuration
# =========================================

# Node Environment
NODE_ENV=development
PORT=3000

# =========================================
# Database (PostgreSQL + Prisma)
# =========================================
DATABASE_URL=postgresql://postgres:admin@localhost:5432/finguard?schema=auth

# =========================================
# JWT Authentication
# =========================================
# Generate secrets with: openssl rand -base64 32
JWT_ACCESS_SECRET=your-access-secret-key-here-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-here-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# =========================================
# Frontend & CORS
# =========================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5176

# =========================================
# Email Service (SMTP for verification/reset)
# =========================================
# For development, use MailHog or similar: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# =========================================
# File Upload
# =========================================
UPLOAD_DIR=uploads/kyc

# =========================================
# Logging
# =========================================
LOG_LEVEL=info

# =========================================
# OAuth2 (Optional - Extension Point)
# =========================================
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_AUTH_URL=
# OAUTH_TOKEN_URL=
# OAUTH_CALLBACK_URL=
