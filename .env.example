# Database Configuration
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=postgres
DB_PORT=5432
DB_NAME=finguard
DATABASE_URL=postgresql://postgres:admin@postgres:5432/finguard

# Redis Configuration
REDIS_URL=redis://redis:6379

# Node Backend Configuration
NODE_ENV=development
PORT=4000
JWT_ACCESS_SECRET=your_jwt_access_secret_min_16_chars_change_in_prod
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_16_chars_change_in_prod
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5176
FASTAPI_URL=http://backend-fastapi:8080

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional: OAuth Configuration
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=
OAUTH_CALLBACK_URL=
