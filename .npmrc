# NPM configuration for workspace optimization

# Use exact versions to ensure consistency across team
save-exact = true

# Prevent unnecessary dependency duplication in workspaces
legacy-peer-deps = false

# Set preferred registry (optional - adjust if using private registry)
# registry=https://registry.npmjs.org/

# Ensure we use workspaces properly
workspaces-update = true

# Set engine-strict to enforce Node version requirement
engine-strict = true

# Audit configuration
audit-level = moderate
fund = false

